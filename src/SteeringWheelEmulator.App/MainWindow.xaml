                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Resists how quickly you turn the wheel.">
                          <TextBlock Text="Damper" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainDamperValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbDamper" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Damper" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainDamperSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Constant drag whenever the wheel is moving.">
                          <TextBlock Text="Friction" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainFrictionValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbFriction" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Friction" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainFrictionSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Makes the wheel feel heavier by resisting changes in turning speed.">
                          <TextBlock Text="Inertia" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainInertiaValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbInertia" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Inertia" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainInertiaSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Vibration effects such as rumble, gravel, and crash shake.">
                          <TextBlock Text="Periodic" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainPeriodicValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbPeriodic" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Periodic" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainPeriodicSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Force that ramps from one strength to another over time.">
                          <TextBlock Text="Ramp" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainRampValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbRamp" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Ramp" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainRampSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Custom force-feedback effects a game downloads besides the standard types.">
                          <TextBlock Text="Custom" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainCustomValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbCustom" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Custom" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainCustomSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  </ScrollViewer>

                  <!-- Right: feel / shaping / centering / advanced / FFB debug (one scroll) -->
                  <ScrollViewer x:Name="FfbFeelScrollViewer" Grid.Column="2"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <Expander Header="Output feel" IsExpanded="True"
                                ToolTip="Adjustments applied to the mixed force before it reaches your wheel.">
                        <StackPanel Margin="0,8,0,0">
                          <DockPanel Margin="0,2,0,0"
                                     ToolTip="Softens harsh detail in the mixed force. Higher is smoother but adds a little delay. 0 = off.">
                            <TextBlock Text="Smoothing" Width="88" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="FeelSmoothingValueText" Width="48" Text="0 ms" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbSmoothing" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="Smoothing" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="FeelSmoothingSlider" Minimum="0" Maximum="40" Value="0" TickFrequency="1"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0" Background="Transparent"
                                     ToolTip="How often the mixed force is sent to your wheel (ms between updates). Higher can smooth choppy feel; 0 = every update. Try 2–5 if forces feel stepped.">
                            <TextBlock Text="Device pace" Width="88" VerticalAlignment="Center" Background="Transparent"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="FeelCfPaceValueText" Width="48" Text="off" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbCfPace" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="CfPace" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="FeelCfPaceSlider" Minimum="0" Maximum="34" Value="0" TickFrequency="1"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0" Background="Transparent"
                                     ToolTip="Blends the mixed force over this many milliseconds so sparse updates feel continuous. 0 = off.">
                            <TextBlock Text="Interpolate" Width="88" VerticalAlignment="Center" Background="Transparent"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="FeelReconstructionValueText" Width="48" Text="off" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbReconstruction" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="Reconstruction" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="FeelReconstructionSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="1"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0" Background="Transparent"
                                     ToolTip="When Interpolate is on, holds the last force for up to this many milliseconds between updates. 0 = blend only.">
                            <TextBlock Text="Gap fill" Width="88" VerticalAlignment="Center" Background="Transparent"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="FeelGapHoldValueText" Width="48" Text="off" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbGapHold" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="GapHold" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="FeelGapHoldSlider" Minimum="0" Maximum="200" Value="0" TickFrequency="1"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0"
                                     ToolTip="Softens the strongest peaks (crashes, big curbs). 0 = off; slide up for more compression.">
                            <TextBlock Text="Peak soft" Width="88" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="FeelPeakSoftValueText" Width="48" Text="off" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbPeakSoft" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="PeakSoft" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="FeelPeakSoftSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.01"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                        </StackPanel>
                      </Expander>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <Expander Header="Torque shaping" IsExpanded="True"
                                ToolTip="Adjustments that clean up noisy or jumpy force in the mix.">
                        <StackPanel Margin="0,8,0,0">
                          <DockPanel Margin="0,2,0,0"
                                     ToolTip="Ignores very small forces so the wheel does not twitch. Not a steering-angle deadzone. 0 = off.">
                            <TextBlock Text="Force deadzone" Width="108" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="FeelDeadbandValueText" Width="48" Text="0" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbDeadband" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="Deadband" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="FeelDeadbandSlider" Minimum="0" Maximum="0.05" Value="0" TickFrequency="0.001"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0"
                                     ToolTip="Limits how fast force can change. Lower is smoother; 0 = unlimited.">
                            <TextBlock Text="Slew rate" Width="108" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="FeelSlewValueText" Width="48" Text="off" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbSlew" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="Slew" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="FeelSlewSlider" Minimum="0" Maximum="200" Value="0" TickFrequency="1"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0"
                                     ToolTip="Limits how fast force can jump toward the target each second. Lower is softer. 0 = off.">
                            <TextBlock Text="Spike cap" Width="108" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="FeelSpikeValueText" Width="48" Text="off" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbSpike" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="Spike" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="FeelSpikeSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.01"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0"
                                     ToolTip="Skips tiny force updates to reduce chatter or buzzing. 0 = off; try about 12.">
                            <TextBlock Text="DI chatter" Width="108" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="FeelEpsilonValueText" Width="48" Text="0" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbEpsilon" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="Epsilon" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="FeelEpsilonSlider" Minimum="0" Maximum="64" Value="0" TickFrequency="1"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                        </StackPanel>
                      </Expander>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <Expander Header="Centering" IsExpanded="True"
                                ToolTip="Extra return-to-center spring for games that leave the wheel loose.">
                        <StackPanel Margin="0,8,0,0">
                          <CheckBox x:Name="ForceCenterCheck" Content="Force center spring"
                                    Checked="ForceCenterCheck_Changed" Unchecked="ForceCenterCheck_Changed"
                                    ToolTip="Adds a centering spring based on your wheel angle, including menus and pause."/>
                          <StackPanel x:Name="CenterSpringPanel" Margin="0,4,0,0" IsEnabled="False" Opacity="0.5">
                            <DockPanel Margin="0,2,0,0"
                                       ToolTip="Maximum centering force. Scaled by Master.">
                              <TextBlock Text="Strength" Width="88" VerticalAlignment="Center"/>
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="CenterStrengthValueText" Width="48" Text="30%" VerticalAlignment="Center"
                                           TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                           MouseLeftButtonDown="FfbValueLabel_Click"/>
                                <Button x:Name="BindFfbCenterStrength" Style="{StaticResource FfbBindButton}" Content="Bind"
                                        Tag="CenterStrength" Click="FfbEffectBind_Click"/>
                              </StackPanel>
                              <Slider x:Name="CenterStrengthSlider" Minimum="0.05" Maximum="1" Value="0.3" TickFrequency="0.01"
                                      ValueChanged="FeelSlider_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0"
                                       ToolTip="How far from center the spring reaches full strength. Lower is stiffer near center.">
                              <TextBlock Text="Range" Width="88" VerticalAlignment="Center"/>
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="CenterRangeValueText" Width="48" Text="25%" VerticalAlignment="Center"
                                           TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                           MouseLeftButtonDown="FfbValueLabel_Click"/>
                                <Button x:Name="BindFfbCenterRange" Style="{StaticResource FfbBindButton}" Content="Bind"
                                        Tag="CenterRange" Click="FfbEffectBind_Click"/>
                              </StackPanel>
                              <Slider x:Name="CenterRangeSlider" Minimum="0.05" Maximum="0.5" Value="0.25" TickFrequency="0.01"
                                      ValueChanged="FeelSlider_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0"
                                       ToolTip="Free zone around center where the spring does not push. 0 = off.">
                              <TextBlock Text="Deadzone" Width="88" VerticalAlignment="Center"/>
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="CenterDeadzoneValueText" Width="48" Text="off" VerticalAlignment="Center"
                                           TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                           MouseLeftButtonDown="FfbValueLabel_Click"/>
                                <Button x:Name="BindFfbCenterDeadzone" Style="{StaticResource FfbBindButton}" Content="Bind"
                                        Tag="CenterDeadzone" Click="FfbEffectBind_Click"/>
                              </StackPanel>
                              <Slider x:Name="CenterDeadzoneSlider" Minimum="0" Maximum="0.05" Value="0" TickFrequency="0.001"
                                      ValueChanged="FeelSlider_ValueChanged"/>
                            </DockPanel>
                          </StackPanel>
                        </StackPanel>
                      </Expander>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <Expander Header="Advanced Settings" IsExpanded="False"
                                ToolTip="Startup mute, invert, steering catch-up, and damper / spring / friction mix scales.">
                        <StackPanel Margin="0,8,0,0">
                          <UniformGrid Columns="2" Margin="0,0,0,4">
                            <CheckBox x:Name="BootEaseInCheck" Content="Boot ease-in" Margin="0,0,10,10"
                                      VerticalAlignment="Center"
                                      ToolTip="When force feedback first starts, mute all forces for 5 seconds so the wheel does not kick. Off = full force immediately."
                                      Checked="BootEaseInCheck_Changed" Unchecked="BootEaseInCheck_Changed"/>
                            <CheckBox x:Name="InvertFfbCheck" Content="Invert FFB" Margin="0,0,0,10"
                                      VerticalAlignment="Center"
                                      ToolTip="Reverses force direction on the wheel (not steering input)."
                                      Checked="InvertFfbCheck_Changed" Unchecked="InvertFfbCheck_Changed"/>
                            <CheckBox x:Name="SoftCatchUpSteerCheck" Content="Soft steering catch-up" Margin="0,0,10,4"
                                      VerticalAlignment="Center"
                                      ToolTip="Limits sudden steering jumps when the wheel briefly stalls. Off by default."
                                      Checked="SoftCatchUpSteerCheck_Changed" Unchecked="SoftCatchUpSteerCheck_Changed"/>
                          <CheckBox x:Name="InvertConstantForceCheck" Content="Invert Constant Force" Margin="0,0,0,4"
                                      VerticalAlignment="Center"
                                    ToolTip="Reverses only the constant-force effect. Independent of Invert FFB."
                                    Checked="MixOption_Changed" Unchecked="MixOption_Changed"/>
                          </UniformGrid>
                          <TextBlock Text="Damper mix" Opacity="0.55" FontSize="11" Margin="0,6,0,6"
                                     ToolTip="Scales how damper and inertia from the game are mixed."/>
                          <DockPanel Margin="0,0,0,0"
                                     ToolTip="How strongly wheel speed feeds into damper and inertia. 100% = as the game sent it.">
                            <TextBlock Text="Damper velocity" Width="108" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="DamperVelScaleValueText" Width="48" Text="100%" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbDampVel" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="DampVel" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="DamperVelScaleSlider" Minimum="0.25" Maximum="2" Value="1" TickFrequency="0.05"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0"
                                     ToolTip="How soon damper engages near zero speed. Lower engages sooner. 100% = as the game sent it.">
                            <TextBlock Text="Damper deadzone" Width="108" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="DamperDeadbandScaleValueText" Width="48" Text="100%" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbDampDead" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="DampDead" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="DamperDeadbandScaleSlider" Minimum="0.1" Maximum="1" Value="1" TickFrequency="0.01"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <TextBlock Text="Condition coefficients" Opacity="0.55" FontSize="11" Margin="0,10,0,6"
                                     Background="Transparent"
                                     ToolTip="Scale spring and friction strength without changing their limits."/>
                          <DockPanel Margin="0,0,0,0" Background="Transparent"
                                     ToolTip="Scales spring strength near center. Above 100% pulls harder sooner. 100% = as the game sent it.">
                            <TextBlock Text="Spring coeff" Width="108" VerticalAlignment="Center" Background="Transparent"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="SpringCoeffScaleValueText" Width="48" Text="100%" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbSpringCoeff" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="SpringCoeff" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="SpringCoeffScaleSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0" Background="Transparent"
                                     ToolTip="Scales friction strength. Higher can feel gritty; lower weakens friction. 100% = as the game sent it.">
                            <TextBlock Text="Friction coeff" Width="108" VerticalAlignment="Center" Background="Transparent"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                              <TextBlock x:Name="FrictionCoeffScaleValueText" Width="48" Text="100%" VerticalAlignment="Center"
                                         TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                         MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Button x:Name="BindFfbFrictionCoeff" Style="{StaticResource FfbBindButton}" Content="Bind"
                                      Tag="FrictionCoeff" Click="FfbEffectBind_Click"/>
                            </StackPanel>
                            <Slider x:Name="FrictionCoeffScaleSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                        </StackPanel>
                      </Expander>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <Expander x:Name="FfbDebugExpander" Header="FFB debug" IsExpanded="False"
                                Expanded="FfbDebugExpander_ExpandedChanged"
                                Collapsed="FfbDebugExpander_ExpandedChanged"
                                ToolTip="Test force feedback and view live effect counters.">
                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                          <StackPanel DockPanel.Dock="Top">
                          <TextBlock Text="Send test forces to your FFB wheel. No game required."
                                     Opacity="0.65" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
                            <CheckBox x:Name="FfbDebugOverlayToggle" Content="FFB Debug Overlay" Margin="0,0,0,10"
                                      ToolTip="Show a topmost overlay with live G920 inputs and FFB diagnostics while you drive. Same as Settings → Overlays."
                                      Checked="FfbDebugOverlayToggle_Changed" Unchecked="FfbDebugOverlayToggle_Changed"/>
                          <WrapPanel Margin="0,0,0,4">
                            <Button Style="{StaticResource WrapButton}" Content="Attach FFB" Click="FfbAttach_Click"
                                    ToolTip="Connect force feedback to the selected wheel."/>
                            <Button Style="{StaticResource WrapButton}" Content="Left" Click="FfbTestLeft_Click"/>
                            <Button Style="{StaticResource WrapButton}" Content="Center" Click="FfbTestCenter_Click"
                                    ToolTip="Toggle a return-to-center spring test."/>
                            <Button Style="{StaticResource WrapButton}" Content="Right" Click="FfbTestRight_Click"/>
                            <Button Style="{StaticResource WrapButton}" Content="Pulse" Click="FfbTestPulse_Click"
                                    ToolTip="Short left/right pulse."/>
                            <Button Style="{StaticResource WrapButton}" Content="Release test" Click="FfbTestRelease_Click"
                                    Margin="0,0,0,8"
                                    ToolTip="Clear the test force so game FFB can drive again."/>
                          </WrapPanel>
                          <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Test torque" Width="88" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FfbTestTorqueValueText" DockPanel.Dock="Right" Width="48"
                                       Text="0%" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <Slider x:Name="FfbTestTorqueSlider" Minimum="-1" Maximum="1" Value="0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="False"
                                    ValueChanged="FfbTestTorqueSlider_ValueChanged"/>
                          </DockPanel>
                          </StackPanel>
                          <ScrollViewer x:Name="FfbDebugDiagScroll" VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <TextBlock x:Name="FfbDiagText" Opacity="0.8" FontSize="12"
                                       FontFamily="Consolas" TextWrapping="NoWrap"
                                       Text="FFB diagnostics will appear here."/>
                          </ScrollViewer>
                        </DockPanel>
                      </Expander>
                    </Border>
                  </StackPanel>
                  </ScrollViewer>
      </Grid>
      <ScrollViewer x:Name="TelemetryPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel Margin="0,0,0,10"
                           ToolTip="Simulated speed/RPM/G-force + FFB rumble/impact for games with no Data Out. SimHub 9.11.5+ - activate Steering Wheel Emulator (simulated). Skip titles that already have a SimHub plugin. Leave Controller Vibration on if the game has it.">
                  <Button x:Name="TelemetryEnabledButton" DockPanel.Dock="Right"
                          Style="{StaticResource BridgeToggleStart}"
                          MinWidth="88" MinHeight="28" Padding="12,5" Margin="0"
                          VerticalAlignment="Center" HorizontalAlignment="Right"
                          Content="Enable"
                          Click="TelemetryEnabledButton_Click"
                          ToolTip="Send simulated telemetry to SimHub while the bridge is running."/>
                  <TextBlock Text="SimHub UDP" Style="{StaticResource SectionTitle}" Margin="0"
                             VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock Text="Host" Width="48" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBox x:Name="TelemetryHostBox" Text="127.0.0.1" LostFocus="TelemetrySettings_Changed"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock Text="Port" Width="48" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBox x:Name="TelemetryPortBox" Text="20778" LostFocus="TelemetrySettings_Changed"
                           ToolTip="Default 20778. Match this in SimHub Game Config for Steering Wheel Emulator (simulated)."/>
                </DockPanel>
                <DockPanel Margin="0,0,0,10"
                           ToolTip="SimHub's External Sim loop is 60 Hz. Packets above that are ignored.">
                  <TextBlock Text="Rate" Width="48" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryHzValueText" DockPanel.Dock="Right" Width="48" Text="60 Hz"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a value"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryHzSlider" Minimum="1" Maximum="60" Value="60" TickFrequency="1"
                          IsSnapToTickEnabled="True" ValueChanged="TelemetryHzSlider_ValueChanged"/>
                </DockPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Margin="0" Padding="10,6" HorizontalAlignment="Stretch"
                          Content="Register with SimHub" Click="TelemetryRegister_Click"
                          ToolTip="Writes a .simlink so SimHub 9.11.5+ can load simhub/G920Telemetry.simdef. Then activate Steering Wheel Emulator (simulated) in SimHub."/>
                  <Button Grid.Column="2" Margin="0" Padding="10,6" HorizontalAlignment="Stretch"
                          Content="Remove registration" Click="TelemetryUnregister_Click"
                          ToolTip="Deletes our SimHub .simlink. Restart SimHub so the game tile (and cached icon) disappear, then Register again."/>
                </Grid>
                <TextBlock x:Name="TelemetryStatusText" Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Telemetry: off"/>
              </StackPanel>
                    </Border>

            <!-- Profile card (same pattern as FFB profile) -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel Margin="0,0,0,8"
                           ToolTip="Saved simulation presets (speed/RPM/gears/scales). Host, port, and rate stay in SimHub UDP above.">
                  <TextBlock Text="Telemetry profile" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"
                             ToolTip="Saved simulation tuning for this setup. Separate from input and FFB profiles."/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="SaveTelemetryProfileButton_Click"
                            ToolTip="Save current simulation tuning to the selected telemetry profile.">
                      <iconPacks:PackIconMaterial Kind="ContentSave" Width="14" Height="14" Foreground="#E8EAED"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="SaveTelemetryProfileAsButton_Click"
                            ToolTip="Save current simulation tuning as a new telemetry profile.">
                      <iconPacks:PackIconMaterial Kind="ContentSavePlus" Width="14" Height="14" Foreground="#E8EAED"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="DefaultTelemetryProfileButton_Click"
                            ToolTip="Reset sliders to built-in defaults. Save to keep the change.">
                      <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Foreground="#E8EAED"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Margin="0" Click="DeleteTelemetryProfileButton_Click"
                            ToolTip="Delete the selected telemetry profile. Default cannot be deleted.">
                      <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="14" Height="14" Foreground="#E8EAED"/>
                    </Button>
                  </StackPanel>
                </DockPanel>
                <ComboBox x:Name="TelemetryProfilesCombo" Margin="0,0,0,8" VerticalAlignment="Center"
                          ToolTip="Select a telemetry simulation profile."
                          SelectionChanged="TelemetryProfilesCombo_SelectionChanged"/>
                <TextBlock Opacity="0.65" FontSize="11" TextWrapping="Wrap"
                           Text="Arcade simulation from pedals + FFB. Walls/crashes use Impact dump - the game never reports true speed."/>
                <!-- Hidden: max speed is derived from tallest gear. -->
                <DockPanel x:Name="TelemetrySpeedMaxPanel" Margin="0,8,0,0" Visibility="Collapsed"
                           ToolTip="Derived from tallest gear max (top of gearing chart).">
                  <TextBlock x:Name="TelemetrySpeedMaxTitle" Text="Max speed" Width="128"
                             VerticalAlignment="Center" Opacity="0.85"
                             TextTrimming="None"/>
                  <TextBlock x:Name="TelemetrySpeedMaxValueText" DockPanel.Dock="Right" Width="76" Text="217 MPH"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a value"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetrySpeedMaxSlider" Minimum="12" Maximum="994" Value="217" TickFrequency="1"
                          Margin="0,0,8,0" IsSnapToTickEnabled="True"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- Effects: speed feel first -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="TelemetryDynamicsTitle" Text="Speed dynamics (MPH/s)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"
                           ToolTip="How quickly simulated speed builds and falls. Stored as km/h/s."/>
                <DockPanel Margin="0,0,0,3"
                           ToolTip="Full-throttle acceleration before gear pull.">
                  <TextBlock Text="Acceleration" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryAccelValueText" DockPanel.Dock="Right" Width="76" Text="34 MPH/s"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a rate"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryAccelSlider" Minimum="3" Maximum="124" Value="34" TickFrequency="1"
                          Margin="0,0,8,0" IsSnapToTickEnabled="True"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,3"
                           ToolTip="Full-brake deceleration.">
                  <TextBlock Text="Brake Force" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryBrakeDynValueText" DockPanel.Dock="Right" Width="76" Text="56 MPH/s"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a rate"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryBrakeDynSlider" Minimum="6" Maximum="186" Value="56" TickFrequency="1"
                          Margin="0,0,8,0" IsSnapToTickEnabled="True"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,3"
                           ToolTip="Coast / engine-brake when lifting throttle.">
                  <TextBlock Text="Coast" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryCoastValueText" DockPanel.Dock="Right" Width="76" Text="17 MPH/s"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a rate"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryCoastSlider" Minimum="0" Maximum="75" Value="17" TickFrequency="1"
                          Margin="0,0,8,0" IsSnapToTickEnabled="True"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,3"
                           ToolTip="Extra drag that grows with speed².">
                  <TextBlock Text="Aero" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryAeroDragValueText" DockPanel.Dock="Right" Width="76" Text="100%"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a value"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryAeroDragSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05"
                          Margin="0,0,8,0" IsSnapToTickEnabled="False"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel x:Name="TelemetryGearPullPanel" Margin="0,0,0,3" Visibility="Collapsed">
                  <TextBlock Text="Gear pull" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryGearPullValueText" DockPanel.Dock="Right" Width="76" Text="100%"
                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                  <Slider x:Name="TelemetryGearPullSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05"
                          Margin="0,0,8,0" IsSnapToTickEnabled="False"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel x:Name="TelemetryGearSettlePanel" Margin="0,0,0,3"
                           ToolTip="After a downshift, how fast speed bleeds down to that gear’s max (engine-braking style). Separate from Coast (lift) and Brake. 0 = snap to the gear cap instantly.">
                  <TextBlock Text="Downshift settle" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryGearSettleValueText" DockPanel.Dock="Right" Width="76" Text="25 MPH/s"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a rate"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryGearSettleSlider" Minimum="0" Maximum="124" Value="25" TickFrequency="1"
                          Margin="0,0,8,0" IsSnapToTickEnabled="True"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel
                           ToolTip="How hard FFB impact spikes cut simulated speed. 0% = off. Holding throttle keeps most speed.">
                  <TextBlock Text="Impact dump" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryCrashDumpValueText" DockPanel.Dock="Right" Width="76" Text="50%"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a value"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryCrashDumpSlider" Minimum="0" Maximum="2" Value="0.5" TickFrequency="0.05"
                          Margin="0,0,8,0" IsSnapToTickEnabled="False"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- Gearing - accuracy -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="TelemetryGearMaxTitle" Text="Gearing" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"
                           ToolTip="Match your car’s ratios, final drive, and tire size. Max speeds follow Redline: MPH = (tire × RPM) / (336 × gear × diff). MaxGears also sets SimHub CarSettings_MaxGears and how many gear rows are shown."/>
                <DockPanel Margin="0,0,0,8"
                           ToolTip="Forward gear count (1–10). Sent to SimHub as MaxGears (CarSettings_MaxGears). Shows that many ratio / top-speed rows. Physical shifter still maps gears 1–6; paddles can go higher for speed simulation.">
                  <TextBlock Text="Max gears" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryMaxGearsValueText" DockPanel.Dock="Right" Width="76" Text="6"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type 1–10"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryMaxGearsSlider" Minimum="1" Maximum="10" Value="6" TickFrequency="1"
                          Margin="0,0,8,0" IsSnapToTickEnabled="True"
                          ValueChanged="TelemetryMaxGearsSlider_ValueChanged"
                          ToolTip="1–10. Default 6."/>
                </DockPanel>
                <DockPanel Margin="0,0,0,3"
                           ToolTip="Shift / redline RPM - each gear’s max speed is road speed at this RPM (SimHub EngineShiftRpm).">
                  <TextBlock Text="Redline / shift" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryRpmRedlineValueText" DockPanel.Dock="Right" Width="76" Text="6000"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type shift/redline RPM"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryRpmRedlineSlider" Minimum="100" Maximum="8000" Value="6000"
                          TickFrequency="50" Margin="0,0,8,0" IsSnapToTickEnabled="True"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,3"
                           ToolTip="Diff / final-drive ratio. Higher = shorter overall gearing; gearbox ratios stay the same; max speeds recalculate.">
                  <TextBlock Text="Diff / final drive" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryDiffRatioValueText" DockPanel.Dock="Right" Width="76" Text="3.42"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a ratio"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryDiffRatioSlider" Minimum="1.5" Maximum="6.5" Value="3.42" TickFrequency="0.01"
                          Margin="0,0,8,0" IsSnapToTickEnabled="False"
                          ValueChanged="TelemetryDiffRatioSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8"
                           ToolTip="Tire diameter (inches). Larger tire → higher max speed in every gear; gearbox ratios stay the same.">
                  <TextBlock Text="Tire diameter" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryTireDiameterValueText" DockPanel.Dock="Right" Width="76" Text='27"'
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type inches"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryTireDiameterSlider" Minimum="18" Maximum="40" Value="27" TickFrequency="0.1"
                          Margin="0,0,8,0" IsSnapToTickEnabled="False"
                          ValueChanged="TelemetryTireDiameterSlider_ValueChanged"/>
                </DockPanel>
                <TextBlock Text="Gear ratios → top speed @ redline" Opacity="0.45" FontSize="10" Margin="0,0,0,2"
                           ToolTip="Edit ratio or max - the other updates. Absolute gearbox ratios. Rows shown match Max gears (1–10)."/>
                <Grid Margin="0,0,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="72"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="1" Text="Ratio" Opacity="0.45" FontSize="10"/>
                  <TextBlock Grid.Column="3" Text="Top speed" Opacity="0.45" FontSize="10"/>
                </Grid>
                <StackPanel x:Name="TelemetryGearRowsHost">
                  <!-- Gear rows 1–10; visibility follows Max gears -->
                  <Grid x:Name="TelemetryGearRow1" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="52"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="1" VerticalAlignment="Center" Opacity="0.85"/>
                    <Slider x:Name="TelemetryGear1RatioSlider" Grid.Column="1" Minimum="0.3" Maximum="8" Value="2.97" TickFrequency="0.01"
                            Margin="0,0,6,0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearRatioSlider_ValueChanged"
                            ToolTip="Absolute gearbox ratio. Higher = shorter gear / lower max speed."/>
                    <TextBlock x:Name="TelemetryGear1RatioValueText" Grid.Column="2" Text="2.97" Margin="0,0,6,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a ratio"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Slider x:Name="TelemetryGear1MaxSlider" Grid.Column="3" Minimum="3" Maximum="994" Value="43" TickFrequency="1"
                            Margin="0,0,6,0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearMaxSlider_ValueChanged" ToolTip="1st gear top speed"/>
                    <TextBlock x:Name="TelemetryGear1MaxValueText" Grid.Column="4" Text="43 MPH"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  </Grid>
                  <Grid x:Name="TelemetryGearRow2" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="2" VerticalAlignment="Center" Opacity="0.85"/>
                    <Slider x:Name="TelemetryGear2RatioSlider" Grid.Column="1" Minimum="0.3" Maximum="8" Value="2.07" TickFrequency="0.01"
                            Margin="0,0,6,0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearRatioSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear2RatioValueText" Grid.Column="2" Text="2.07" Margin="0,0,6,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a ratio"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Slider x:Name="TelemetryGear2MaxSlider" Grid.Column="3" Minimum="3" Maximum="994" Value="75" TickFrequency="1"
                            Margin="0,0,6,0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearMaxSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear2MaxValueText" Grid.Column="4" Text="75 MPH"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  </Grid>
                  <Grid x:Name="TelemetryGearRow3" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="3" VerticalAlignment="Center" Opacity="0.85"/>
                    <Slider x:Name="TelemetryGear3RatioSlider" Grid.Column="1" Minimum="0.3" Maximum="8" Value="1.43" TickFrequency="0.01"
                            Margin="0,0,6,0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearRatioSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear3RatioValueText" Grid.Column="2" Text="1.43" Margin="0,0,6,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a ratio"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Slider x:Name="TelemetryGear3MaxSlider" Grid.Column="3" Minimum="3" Maximum="994" Value="109" TickFrequency="1"
                            Margin="0,0,6,0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearMaxSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear3MaxValueText" Grid.Column="4" Text="109 MPH"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  </Grid>
                  <Grid x:Name="TelemetryGearRow4" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="4" VerticalAlignment="Center" Opacity="0.85"/>
                    <Slider x:Name="TelemetryGear4RatioSlider" Grid.Column="1" Minimum="0.3" Maximum="8" Value="1.00" TickFrequency="0.01"
                            Margin="0,0,6,0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearRatioSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear4RatioValueText" Grid.Column="2" Text="1.00" Margin="0,0,6,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a ratio"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Slider x:Name="TelemetryGear4MaxSlider" Grid.Column="3" Minimum="3" Maximum="994" Value="143" TickFrequency="1"
                            Margin="0,0,6,0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearMaxSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear4MaxValueText" Grid.Column="4" Text="143 MPH"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  </Grid>
                  <Grid x:Name="TelemetryGearRow5" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="5" VerticalAlignment="Center" Opacity="0.85"/>
                    <Slider x:Name="TelemetryGear5RatioSlider" Grid.Column="1" Minimum="0.3" Maximum="8" Value="0.84" TickFrequency="0.01"
                            Margin="0,0,6,0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearRatioSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear5RatioValueText" Grid.Column="2" Text="0.84" Margin="0,0,6,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a ratio"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Slider x:Name="TelemetryGear5MaxSlider" Grid.Column="3" Minimum="3" Maximum="994" Value="177" TickFrequency="1"
                            Margin="0,0,6,0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearMaxSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear5MaxValueText" Grid.Column="4" Text="177 MPH"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  </Grid>
                  <Grid x:Name="TelemetryGearRow6" Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="6" VerticalAlignment="Center" Opacity="0.85"/>
                    <Slider x:Name="TelemetryGear6RatioSlider" Grid.Column="1" Minimum="0.3" Maximum="8" Value="0.56" TickFrequency="0.01"
                            Margin="0,0,6,0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearRatioSlider_ValueChanged"
                            ToolTip="Absolute gear ratio (often overdrive on tall gears)."/>
                    <TextBlock x:Name="TelemetryGear6RatioValueText" Grid.Column="2" Text="0.56" Margin="0,0,6,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a ratio"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Slider x:Name="TelemetryGear6MaxSlider" Grid.Column="3" Minimum="3" Maximum="994" Value="217" TickFrequency="1"
                            Margin="0,0,6,0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearMaxSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear6MaxValueText" Grid.Column="4" Text="217 MPH"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  </Grid>
                  <Grid x:Name="TelemetryGearRow7" Margin="0,0,0,3" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="7" VerticalAlignment="Center" Opacity="0.85"/>
                    <Slider x:Name="TelemetryGear7RatioSlider" Grid.Column="1" Minimum="0.3" Maximum="8" Value="0.48" TickFrequency="0.01"
                            Margin="0,0,6,0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearRatioSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear7RatioValueText" Grid.Column="2" Text="0.48" Margin="0,0,6,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a ratio"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Slider x:Name="TelemetryGear7MaxSlider" Grid.Column="3" Minimum="3" Maximum="994" Value="248" TickFrequency="1"
                            Margin="0,0,6,0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearMaxSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear7MaxValueText" Grid.Column="4" Text="248 MPH"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  </Grid>
                  <Grid x:Name="TelemetryGearRow8" Margin="0,0,0,3" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="8" VerticalAlignment="Center" Opacity="0.85"/>
                    <Slider x:Name="TelemetryGear8RatioSlider" Grid.Column="1" Minimum="0.3" Maximum="8" Value="0.42" TickFrequency="0.01"
                            Margin="0,0,6,0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearRatioSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear8RatioValueText" Grid.Column="2" Text="0.42" Margin="0,0,6,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a ratio"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Slider x:Name="TelemetryGear8MaxSlider" Grid.Column="3" Minimum="3" Maximum="994" Value="280" TickFrequency="1"
                            Margin="0,0,6,0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearMaxSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear8MaxValueText" Grid.Column="4" Text="280 MPH"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  </Grid>
                  <Grid x:Name="TelemetryGearRow9" Margin="0,0,0,3" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="9" VerticalAlignment="Center" Opacity="0.85"/>
                    <Slider x:Name="TelemetryGear9RatioSlider" Grid.Column="1" Minimum="0.3" Maximum="8" Value="0.37" TickFrequency="0.01"
                            Margin="0,0,6,0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearRatioSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear9RatioValueText" Grid.Column="2" Text="0.37" Margin="0,0,6,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a ratio"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Slider x:Name="TelemetryGear9MaxSlider" Grid.Column="3" Minimum="3" Maximum="994" Value="312" TickFrequency="1"
                            Margin="0,0,6,0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearMaxSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear9MaxValueText" Grid.Column="4" Text="312 MPH"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  </Grid>
                  <Grid x:Name="TelemetryGearRow10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="10" VerticalAlignment="Center" Opacity="0.85"/>
                    <Slider x:Name="TelemetryGear10RatioSlider" Grid.Column="1" Minimum="0.3" Maximum="8" Value="0.33" TickFrequency="0.01"
                            Margin="0,0,6,0" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearRatioSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear10RatioValueText" Grid.Column="2" Text="0.33" Margin="0,0,6,0"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a ratio"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Slider x:Name="TelemetryGear10MaxSlider" Grid.Column="3" Minimum="3" Maximum="994" Value="341" TickFrequency="1"
                            Margin="0,0,6,0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="TelemetryGearMaxSlider_ValueChanged"/>
                    <TextBlock x:Name="TelemetryGear10MaxValueText" Grid.Column="4" Text="341 MPH"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Engine / RPM" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"
                           ToolTip="Gauge range and rev-limiter feel. Gear top speeds use Redline in Gearing, not Max RPM."/>
                <DockPanel Margin="0,0,0,3" MinHeight="28"
                           ToolTip="Idle (left) · Max RPM (right). Max RPM is the SimHub gauge ceiling (EngineMaxRpm). Gear tops follow Redline in Gearing.">
                  <TextBlock Text="RPM idle-max" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
                              VerticalAlignment="Center">
                    <TextBlock x:Name="TelemetryRpmMinValueText" Width="52" Text="800"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Cursor="Hand" ToolTip="Click to type idle RPM"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <TextBlock Text="-" Width="14" Opacity="0.45" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TelemetryRpmMaxValueText" Width="56" Text="8000"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Cursor="Hand" ToolTip="Click to type max RPM (EngineMaxRpm)"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  </StackPanel>
                  <controls:DualRangeSlider x:Name="TelemetryRpmRange"
                                           Minimum="0" Maximum="12000"
                                           LowerValue="800" UpperValue="8000"
                                           TickFrequency="50" IsSnapToTickEnabled="True"
                                           LowerValueChanged="TelemetryRangeThumb_Changed"
                                           UpperValueChanged="TelemetryRangeThumb_Changed"
                                           RangeChanged="TelemetryRange_Changed"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,3"
                           ToolTip="Hard-cut rev-limiter depth when pinned at Redline / gear top (0 = off, 100% ≈ 180 RPM drop before restore, 200% ≈ 360 RPM).">
                  <TextBlock Text="Rev-limiter" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryRpmBounceAmountValueText" DockPanel.Dock="Right" Width="76" Text="55%"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a value"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryRpmBounceAmountSlider" Minimum="0" Maximum="2" Value="0.55" TickFrequency="0.05"
                          Margin="0,0,8,0" IsSnapToTickEnabled="False"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel
                           ToolTip="How fast the hard-cut cycles on/off (Hz) while the rev-limiter is engaged.">
                  <TextBlock Text="Limiter rate" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryRpmBounceHzValueText" DockPanel.Dock="Right" Width="76" Text="12 Hz"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type Hz"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryRpmBounceHzSlider" Minimum="2" Maximum="30" Value="12" TickFrequency="1"
                          Margin="0,0,8,0" IsSnapToTickEnabled="True"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="ShakeIt / FFB scales" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <DockPanel Margin="0,0,0,3"
                           ToolTip="Multiply ShakeIt Engine vibrations force (RPM load × this scale). RPM values stay accurate for dashes.">
                  <TextBlock Text="Engine" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryEngineVibrationScaleValueText" DockPanel.Dock="Right" Width="76" Text="100%"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a value"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryEngineVibrationScaleSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05"
                          Margin="0,0,8,0" IsSnapToTickEnabled="False"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,3"
                           ToolTip="Multiply SurfaceRumble (FFB vibration magnitude) before sending to SimHub.">
                  <TextBlock Text="Rumble" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryRumbleScaleValueText" DockPanel.Dock="Right" Width="76" Text="100%"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a value"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryRumbleScaleSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05"
                          Margin="0,0,8,0" IsSnapToTickEnabled="False"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,3"
                           ToolTip="Multiply Impact before sending to SimHub.">
                  <TextBlock Text="Impact" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryImpactScaleValueText" DockPanel.Dock="Right" Width="76" Text="100%"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a value"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryImpactScaleSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05"
                          Margin="0,0,8,0" IsSnapToTickEnabled="False"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel ToolTip="Multiply RoadLoad before sending to SimHub.">
                  <TextBlock Text="Road load" Width="128" VerticalAlignment="Center" Opacity="0.85"/>
                  <TextBlock x:Name="TelemetryRoadLoadScaleValueText" DockPanel.Dock="Right" Width="76" Text="100%"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Cursor="Hand" ToolTip="Click to type a value"
                             MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                  <Slider x:Name="TelemetryRoadLoadScaleSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.05"
                          Margin="0,0,8,0" IsSnapToTickEnabled="False"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
              </StackPanel>
            </Border>

            <!-- Arcade handbrake / NOS / sequential gear - hardware bind on input profile -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Arcade buttons" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"
                           ToolTip="Bind hardware buttons (same dialog as FFB). Handbrake/NOS are hold; sequential gear is press. Gear binds save on the input profile; the enable toggle and strength/boost stay on the telemetry profile."/>

                <CheckBox x:Name="TelemetrySequentialArcadeCheck" Content="Sequential shifter"
                          Margin="0,0,0,8"
                          ToolTip="When enabled, telemetry gear ignores H-pattern and bumper paddles. Use Gear Up / Down / Reset binds instead: R → 1 → Max gears; Reset jumps to 1."
                          Checked="TelemetrySequentialArcadeCheck_Changed"
                          Unchecked="TelemetrySequentialArcadeCheck_Changed"/>
                <StackPanel x:Name="TelemetrySequentialArcadeBindsPanel" Visibility="Collapsed" Margin="0,0,0,10">
                  <TextBlock Text="R → 1 → Max gears · Reset → 1" FontSize="11" Opacity="0.55" Margin="0,0,0,6"/>
                  <DockPanel Margin="0,2,0,0"
                             ToolTip="Press once to upshift (R→1→…→Max). Rising edge only.">
                    <TextBlock Text="Gear up" Width="88" VerticalAlignment="Center" Opacity="0.85"/>
                    <Button x:Name="TelemetryGearUpBindButton" DockPanel.Dock="Right"
                            Style="{StaticResource FfbBindButton}" Content="Bind"
                            Click="TelemetryGearUpBind_Click"/>
                  </DockPanel>
                  <DockPanel Margin="0,6,0,0"
                             ToolTip="Press once to downshift (…→1→R). Rising edge only.">
                    <TextBlock Text="Gear down" Width="88" VerticalAlignment="Center" Opacity="0.85"/>
                    <Button x:Name="TelemetryGearDownBindButton" DockPanel.Dock="Right"
                            Style="{StaticResource FfbBindButton}" Content="Bind"
                            Click="TelemetryGearDownBind_Click"/>
                  </DockPanel>
                  <DockPanel Margin="0,6,0,0"
                             ToolTip="Press once to jump back to gear 1.">
                    <TextBlock Text="Gear reset" Width="88" VerticalAlignment="Center" Opacity="0.85"/>
                    <Button x:Name="TelemetryGearResetBindButton" DockPanel.Dock="Right"
                            Style="{StaticResource FfbBindButton}" Content="Bind"
                            Click="TelemetryGearResetBind_Click"/>
                  </DockPanel>
                </StackPanel>

                <DockPanel Margin="0,2,0,0"
                           ToolTip="Hold the bound button to dump speed (stacks with Brake Force). Bind assigns hardware like FFB effect binds.">
                  <TextBlock Text="Handbrake" Width="88" VerticalAlignment="Center" Opacity="0.85"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TelemetryHandbrakeStrengthValueText" Width="72" Text="50 MPH/s"
                               VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,6,0"
                               Cursor="Hand" ToolTip="Click to type a rate"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Button x:Name="TelemetryHandbrakeBindButton" Style="{StaticResource FfbBindButton}" Content="Bind"
                            Click="TelemetryHandbrakeBind_Click"/>
                  </StackPanel>
                  <Slider x:Name="TelemetryHandbrakeStrengthSlider" Minimum="0" Maximum="124" Value="50" TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Margin="0,8,0,0"
                           ToolTip="Hold the bound button for extra accel toward the current gear max (not infinite top speed).">
                  <TextBlock Text="NOS / Turbo" Width="88" VerticalAlignment="Center" Opacity="0.85"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TelemetryNosBoostValueText" Width="72" Text="25 MPH/s"
                               VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,6,0"
                               Cursor="Hand" ToolTip="Click to type a rate"
                               MouseLeftButtonDown="TelemetryValueLabel_Click"/>
                    <Button x:Name="TelemetryNosBindButton" Style="{StaticResource FfbBindButton}" Content="Bind"
                            Click="TelemetryNosBind_Click"/>
                  </StackPanel>
                  <Slider x:Name="TelemetryNosBoostSlider" Minimum="0" Maximum="93" Value="25" TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          ValueChanged="TelemetryTuningSlider_ValueChanged"/>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Live Telemetry" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <CheckBox x:Name="TelemetryDebugOverlayToggle" Content="Telemetry Debug Overlay" Margin="0,0,0,10"
                          ToolTip="Show a topmost overlay with the live SimHub telemetry packet being sent. Same as Settings → Overlays."
                          Checked="TelemetryDebugOverlayToggle_Changed" Unchecked="TelemetryDebugOverlayToggle_Changed"/>

                <!-- Pedals / wheel (mapped inputs) -->
                <TextBlock Text="Inputs" Opacity="0.55" FontSize="11" Margin="0,0,0,6"/>
                <TextBlock x:Name="TelemetrySteerText" Text="Steering: 0.00" FontSize="11" Opacity="0.85"/>
                <ProgressBar x:Name="TelemetrySteerBar" Height="7" Minimum="-1" Maximum="1" Value="0" Margin="0,2,0,6"
                             Foreground="#2A9D8F"/>
                <TextBlock x:Name="TelemetryThrottleText" Text="Throttle: 0%" FontSize="11" Opacity="0.85"/>
                <ProgressBar x:Name="TelemetryThrottleBar" Height="7" Minimum="0" Maximum="1" Value="0" Margin="0,2,0,6"
                             Foreground="#1F6F4A"/>
                <TextBlock x:Name="TelemetryBrakeText" Text="Brake: 0%" FontSize="11" Opacity="0.85"/>
                <ProgressBar x:Name="TelemetryBrakeBar" Height="7" Minimum="0" Maximum="1" Value="0" Margin="0,2,0,6"
                             Foreground="#B33A3A"/>
                <TextBlock x:Name="TelemetryClutchText" Text="Clutch: 0%" FontSize="11" Opacity="0.85"/>
                <ProgressBar x:Name="TelemetryClutchBar" Height="7" Minimum="0" Maximum="1" Value="0" Margin="0,2,0,10"
                             Foreground="#C9A227"/>

                <!-- Arcade vehicle state sent to SimHub -->
                <TextBlock Text="Simulated" Opacity="0.55" FontSize="11" Margin="0,2,0,6"/>
                <TextBlock x:Name="TelemetryGearText" Text="Gear N" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock x:Name="TelemetrySpeedText" Text="Speed: 0 MPH" FontSize="11" Opacity="0.85"/>
                <ProgressBar x:Name="TelemetrySpeedBar" Height="7" Minimum="0" Maximum="350" Value="0" Margin="0,2,0,6" Foreground="#2A9D8F"/>
                <TextBlock x:Name="TelemetryRpmText" Text="RPM: 0" FontSize="11" Opacity="0.85"/>
                <ProgressBar x:Name="TelemetryRpmBar" Height="7" Minimum="0" Maximum="8000" Value="0" Margin="0,2,0,6" Foreground="#C9A227"/>
                <TextBlock x:Name="TelemetryEngineVibText" Text="Engine vibration: 0%" FontSize="11" Opacity="0.85"/>
                <ProgressBar x:Name="TelemetryEngineVibBar" Height="7" Minimum="0" Maximum="1" Value="0" Margin="0,2,0,8" Foreground="#C97B27"/>
                <DockPanel Margin="0,0,0,4">
                  <Ellipse x:Name="TelemetryHandbrakeLiveDot" DockPanel.Dock="Right" Width="10" Height="10"
                           Fill="#3A4254" Stroke="#2A3140" StrokeThickness="1" VerticalAlignment="Center"
                           ToolTip="Handbrake"/>
                  <TextBlock Text="Handbrake" FontSize="11" Opacity="0.85" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                  <Ellipse x:Name="TelemetryNosLiveDot" DockPanel.Dock="Right" Width="10" Height="10"
                           Fill="#3A4254" Stroke="#2A3140" StrokeThickness="1" VerticalAlignment="Center"
                           ToolTip="NOS / Turbo"/>
                  <TextBlock Text="NOS / Turbo" FontSize="11" Opacity="0.85" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="G-force" Opacity="0.45" FontSize="10" Margin="0,2,0,4"
                           ToolTip="Vehicle-frame G-G (same signs as SimHub): up = accel, down = brake, left/right = turn. Outer ring = 2 g."/>
                <Grid Width="168" Height="168" HorizontalAlignment="Left" Margin="0,0,0,4"
                      ToolTip="Up = accel (+surge), down = brake (−surge), left = left turn (+sway). Outer 2 g, inner 1 g.">
                  <Canvas x:Name="TelemetryGForceCanvas" Width="168" Height="168" ClipToBounds="True">
                    <Ellipse Width="160" Height="160" Canvas.Left="4" Canvas.Top="4"
                             Stroke="#3A4254" StrokeThickness="1.5" Fill="#141820"/>
                    <Ellipse Width="80" Height="80" Canvas.Left="44" Canvas.Top="44"
                             Stroke="#2A3140" StrokeThickness="1" StrokeDashArray="2 2"/>
                    <Line X1="84" Y1="8" X2="84" Y2="160" Stroke="#2A3140" StrokeThickness="1"/>
                    <Line X1="8" Y1="84" X2="160" Y2="84" Stroke="#2A3140" StrokeThickness="1"/>
                    <TextBlock Text="A" Canvas.Left="79" Canvas.Top="6" FontSize="9" Opacity="0.45" Foreground="#E8EAED"
                               ToolTip="Accel - +surge (vehicle forward)"/>
                    <TextBlock Text="B" Canvas.Left="79" Canvas.Top="150" FontSize="9" Opacity="0.45" Foreground="#E8EAED"
                               ToolTip="Brake - −surge"/>
                    <TextBlock Text="L" Canvas.Left="8" Canvas.Top="76" FontSize="9" Opacity="0.45" Foreground="#E8EAED"
                               ToolTip="Left turn (+sway)"/>
                    <TextBlock Text="R" Canvas.Left="152" Canvas.Top="76" FontSize="9" Opacity="0.45" Foreground="#E8EAED"
                               ToolTip="Right turn (−sway)"/>
                    <Ellipse x:Name="TelemetryGForceBall" Width="14" Height="14"
                             Canvas.Left="77" Canvas.Top="77"
                             Fill="#2A9D8F" Stroke="#E8EAED" StrokeThickness="1"/>
                  </Canvas>
                </Grid>
                <TextBlock x:Name="TelemetryGForceText" Text="0.00 g  ·  surge 0.00  sway 0.00  heave 0.00"
                           FontSize="11" Opacity="0.85" Margin="0,0,0,10" TextWrapping="Wrap"
                           ToolTip="XY magnitude and vehicle-frame axes in g (same signs as SimHub Local*Ms2 / 9.81). surge+: throttle, surge−: brake, sway+: left."/>

                <!-- FFB-derived channels -->
                <TextBlock Text="From FFB" Opacity="0.55" FontSize="11" Margin="0,2,0,6"/>
                <TextBlock x:Name="TelemetryRumbleText" Text="Surface rumble: 0%" FontSize="11" Opacity="0.85"/>
                <ProgressBar x:Name="TelemetryRumbleBar" Height="7" Minimum="0" Maximum="1" Value="0" Margin="0,2,0,6" Foreground="#1F6F4A"/>
                <TextBlock x:Name="TelemetryImpactText" Text="Impact: 0%" FontSize="11" Opacity="0.85"/>
                <ProgressBar x:Name="TelemetryImpactBar" Height="7" Minimum="0" Maximum="1" Value="0" Margin="0,2,0,6" Foreground="#B33A3A"/>
                <TextBlock x:Name="TelemetryLoadText" Text="Road load: 0%" FontSize="11" Opacity="0.85"/>
                <ProgressBar x:Name="TelemetryLoadBar" Height="7" Minimum="0" Maximum="1" Value="0" Margin="0,2,0,0" Foreground="#5B7C99"/>
              </StackPanel>
            </Border>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
